# NUMA environment variables
# Copy to .env.local — never commit real keys.

# Shared Supabase host is OK; NUMA data lives in Postgres schema `numa`
# and storage bucket `numa-source-media` only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used in auth email links (confirmation, password reset).
# Falls back to the request host, then http://localhost:3000.
# Must match a Redirect URL in Supabase → Authentication → URL Configuration.
# NEXT_PUBLIC_SITE_URL=https://numa.example.com

# Server-only — never expose to the browser / never commit.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only — receipt OCR via OpenAI Vision. Without it, /fota still works manually.
# OPENAI_API_KEY=

# Optional static FX for reference display (THB -> SEK). Not live.
# NUMA_FX_THB_SEK_RATE=
# NUMA_FX_THB_SEK_AS_OF=
