# NUMA environment variables
# Copy to .env.local and fill in values when connecting Supabase.

# Phase 0 defaults to a local JSON store under .data/ when Supabase is unset.
# Set both URL and anon key to enable Supabase clients (auth/RLS path).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional service role — server-only, never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional static FX for reference display (THB -> SEK). Not live.
# Example: 1 THB = 0.266 SEK
# NUMA_FX_THB_SEK_RATE=
# NUMA_FX_THB_SEK_AS_OF=
