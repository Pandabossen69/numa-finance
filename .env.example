# NUMA environment variables
# Copy to .env.local — never commit real keys.

# Shared Supabase host is OK; NUMA data lives in Postgres schema `numa`
# and storage bucket `numa-source-media` only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Mer → Ny användare (server only — never NEXT_PUBLIC_, never commit).
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only — receipt OCR via OpenAI Vision. Without it, /fota still works manually.
# OPENAI_API_KEY=

# Optional: canonical app URL (defaults to https://numa-finance.vercel.app).
# NEXT_PUBLIC_APP_URL=https://numa-finance.vercel.app

# Runtime errors → Sentry project numa-finance. DSN is a public ingest key.
# Already set on Vercel Preview + Production as SENTRY_DSN.
# SENTRY_DSN=
# Optional client alias if you prefer not to rely on next.config env mapping:
# NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload on Vercel builds (not required for error capture):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=numa-finance
# Set to 0 to disable the isolated Preview/dev test route.
# SENTRY_TEST_ROUTE=

